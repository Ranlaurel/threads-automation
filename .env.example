# LLM — любой OpenAI-совместимый провайдер
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
GEN_MODEL=deepseek-reasoner
# Прокси для LLM-запросов (нужно, если провайдер блокирует регион сервера,
# например OpenAI). Формат: http://user:pass@host:port. Оставь пустым, если
# не нужно (DeepSeek с российских серверов работает напрямую).
LLM_PROXY_URL=

# Очередь хуков
HOOKS_LOW_WATERMARK=5
HOOKS_BATCH_MIN=100
HOOKS_BATCH_MAX=200

# Треды
THREADS_PER_DAY=8

# Постинг
STORAGE_STATE_PATH=storage_state.json
POSTING_WINDOW_START_HOUR=8
POSTING_WINDOW_END_HOUR=22
# Прокси для браузера (Playwright), если Threads/Meta заблокирован для
# прямого доступа с IP сервера (например, РФ). Формат тот же, что у
# LLM_PROXY_URL. Можно указать тот же самый прокси.
BROWSER_PROXY_URL=

DB_PATH=data/threads.db
TOV_PATH=prompts/tov.md
HOOKS_LIBRARY_PATH=prompts/hooks_library.md
